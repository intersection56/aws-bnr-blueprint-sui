##############################################################
# Sui Mainnet - sui-node RPC Full Node
# x86_64, High Availability (ALB + Auto Scaling group), NVMe instance store
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Stack Name Prefix (optional - deploy multiple stacks with same config on one account)
# STACK_NAME_PREFIX="DEV"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="sui"
DEPLOYMENT_MODE="ha-nodes"
BC_NETWORK="mainnet"
CLIENT_CONFIG="sui-node-v1.83.1-full.sh"

# Instance Configuration
# i7i.4xlarge: 16 vCPU, 128 GiB RAM, 1 x 3750 GB NVMe - matches Sui's suggested
# minimum (8 physical cores / 16 vCPU, 128 GB RAM, NVMe SSD).
INSTANCE_TYPE="i7i.4xlarge"
CPU_TYPE="x86_64"

# Storage Configuration - NVMe instance store (data is lost on stop/start;
# the node restores a fresh formal snapshot automatically)
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="3750"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# true = restore the latest verified formal snapshot with sui-tool (free
# Mysten Labs endpoint). Syncing from genesis is not recommended by Sui.
SNAPSHOT_ENABLED="true"

# Traffic Shaping Configuration
# Sui produces several checkpoints per second; MAX_BLOCKS_BEHIND is in checkpoints.
TRAFFIC_SHAPING_ENABLED="true"
TRAFFIC_SHAPING_RATE_MBIT="40"
TRAFFIC_SHAPING_CHECK_INTERVAL_SEC="60"
TRAFFIC_SHAPING_MAX_BLOCKS_BEHIND="300"

# High Availability Configuration
# The ALB health-checks sui-node's GET /health on the RPC port. It returns 200
# only once the node has executed checkpoints and (with indexing enabled) its
# live-object indexes are within 60 checkpoints of the executed tip, so a node
# still restoring its snapshot or building indexes receives no traffic.
# The ALB forwards HTTP/1.1: gRPC-Web clients work through it; native gRPC
# (HTTP/2) clients should target instances directly inside the VPC.
# 3 nodes recommended for production (ADR-0024): with 2, a rolling upgrade or a
# replacement leaves one node serving for hours with no spare. Each node costs
# ~$1,102/month on-demand (i7i.4xlarge, us-east-1, prices as of 2026-11-02).
HA_NUMBER_OF_NODES="3"
HA_ALB_HEALTHCHECK_PORT="9000"
HA_ALB_HEALTHCHECK_PATH="/health"
HA_ALB_HEALTHCHECK_HTTP_CODES="200"
# A new node downloads ~1.2 GB of binaries, restores a formal snapshot and
# builds gRPC indexes before it turns healthy. On testnet this took 3h43m with
# the restore succeeding first time (measured 2026-11-03); mainnet holds several
# times more data and has not been measured. When the grace period ends, the
# Auto Scaling group replaces any node whose /health is not 200, which restarts
# its bootstrap from scratch, so this is set to 24 hours. Shorten it once you
# have measured mainnet bootstrap time.
HA_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="1440"
HA_ALB_HEALTHCHECK_INTERVAL_SEC="30"
HA_ALB_HEALTHCHECK_TIMEOUT_SEC="10"
HA_ALB_HEALTHCHECK_HEALTHY_THRESHOLD="3"
HA_ALB_HEALTHCHECK_UNHEALTHY_THRESHOLD="2"
# Lifecycle-hook timeout. The framework completes the hook early in setup
# (before the snapshot restore), so this only covers boot and storage setup.
# 120 minutes is the AWS maximum (7200 s).
HA_NODES_HEARTBEAT_DELAY_MIN="120"
HA_ALB_DEREGISTRATION_DELAY_SEC="30"

# ALB Exposure (security)
# By default the load balancer is INTERNAL (reachable only inside the VPC) and
# ingress is restricted to the VPC CIDR. To expose the RPC endpoint beyond the
# VPC, uncomment and set the following:
# HA_ALB_INTERNET_FACING="true"          # expose the ALB to the internet (use with caution)
# HA_ALB_ALLOWED_CIDR="203.0.113.0/24"   # REQUIRED when internet-facing: restrict to trusted source IPs
# HA_ALB_CERTIFICATE_ARN="arn:aws:acm:REGION:ACCOUNT:certificate/ID"  # enable HTTPS (TLS terminated at the ALB)

# Sui Custom Configuration
# gRPC indexes (owned objects, balances, ledger history list APIs)
SUI_ENABLE_INDEXING="true"
# Object versions kept, in epochs (Sui's recommendation for RPC full nodes)
SUI_NUM_EPOCHS_TO_RETAIN="5"
# Transactions/effects/events kept, in epochs (must be >= 2)
SUI_NUM_EPOCHS_TO_RETAIN_FOR_CHECKPOINTS="2"
# Archival fallback: auto = on for testnet, off for mainnet (mainnet needs extra IAM, see README)
SUI_ARCHIVE_FALLBACK="auto"
# sui-node RUST_LOG filter
SUI_RUST_LOG="info"
# Snapshot restore tuning (ADR-0025): 50 retries ride out the checkpoint-fetch
# timeouts that aborted most first restore attempts with sui-tool's default of 10
SUI_SNAPSHOT_MAX_RETRIES="50"
SUI_SNAPSHOT_PARALLEL_DOWNLOADS="50"
# Never-downgrade safeguard (ADR-0022): when setup re-runs after an in-place
# upgrade (scripts/upgrade-in-place.sh), keep the newer installed release instead
# of reinstalling the older CLIENT_CONFIG. Set true only to roll back on purpose.
SUI_ALLOW_DOWNGRADE="false"
