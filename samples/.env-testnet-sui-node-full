##############################################################
# Sui Testnet - sui-node RPC Full Node
# x86_64, single node, NVMe instance store
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Stack Name Prefix (optional - deploy multiple stacks with same config on one account)
# STACK_NAME_PREFIX="DEV"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="sui"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="testnet"
CLIENT_CONFIG="sui-node-v1.83.1-full.sh"

# Instance Configuration
# i7i.4xlarge: 16 vCPU, 128 GiB RAM, 1 x 3750 GB NVMe - matches Sui's suggested
# minimum (8 physical cores / 16 vCPU, 128 GB RAM, NVMe SSD).
INSTANCE_TYPE="i7i.4xlarge"
CPU_TYPE="x86_64"

# Storage Configuration - NVMe instance store (data is lost on stop/start;
# the node restores a fresh formal snapshot automatically)
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="3750"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# true = restore the latest verified formal snapshot with sui-tool (free
# Mysten Labs endpoint). Syncing from genesis is not recommended by Sui.
SNAPSHOT_ENABLED="true"

# Traffic Shaping Configuration
# Sui produces several checkpoints per second; MAX_BLOCKS_BEHIND is in checkpoints.
TRAFFIC_SHAPING_ENABLED="true"
TRAFFIC_SHAPING_RATE_MBIT="40"
TRAFFIC_SHAPING_CHECK_INTERVAL_SEC="60"
TRAFFIC_SHAPING_MAX_BLOCKS_BEHIND="300"

# Sui Custom Configuration
# gRPC indexes (owned objects, balances, ledger history list APIs)
SUI_ENABLE_INDEXING="true"
# Object versions kept, in epochs (Sui's recommendation for RPC full nodes)
SUI_NUM_EPOCHS_TO_RETAIN="5"
# Transactions/effects/events kept, in epochs (must be >= 2)
SUI_NUM_EPOCHS_TO_RETAIN_FOR_CHECKPOINTS="2"
# Archival fallback: auto = on for testnet, off for mainnet (mainnet needs extra IAM, see README)
SUI_ARCHIVE_FALLBACK="auto"
# sui-node RUST_LOG filter
SUI_RUST_LOG="info"
# Snapshot restore tuning (ADR-0025): 50 retries ride out the checkpoint-fetch
# timeouts that aborted most first restore attempts with sui-tool's default of 10
SUI_SNAPSHOT_MAX_RETRIES="50"
SUI_SNAPSHOT_PARALLEL_DOWNLOADS="50"
# Never-downgrade safeguard (ADR-0022): when setup re-runs after an in-place
# upgrade (scripts/upgrade-in-place.sh), keep the newer installed release instead
# of reinstalling the older CLIENT_CONFIG. Set true only to roll back on purpose.
SUI_ALLOW_DOWNGRADE="false"
